target Python{};

import FrostMachine from "../frost/src/lib/FrostMachine.lf"
import FrostBus from "../frost/src/lib/FrostBus.lf"

preamble{=
    import time
=}

reactor EMCO_Mill_105 extends FrostMachine{
    # MillingMachine
    state mill_busy         = {= self.data_model.get_node("MillingMachine/Busy") =}

    # Door
    state door_isClosed     = {= self.data_model.get_node("MillingMachine/Door/Variables/IsClosed") =}
    state door_isMoving     = {= self.data_model.get_node("MillingMachine/Door/Variables/IsMoving") =}
    state door_time         = {= self.data_model.get_node("MillingMachine/Door/Variables/Time") =}
    state door_m_openClose  = {= self.data_model.get_node("MillingMachine/Door/Methods/OpenClose") =}
    method openClose_door(wannaClose) {=
        if self.door_isMoving.value:
            return False
            
        self.door_isMoving.value = True
        if wannaClose:
            self.logger.debug(f"Closing door...")
            if not self.door_isClosed.value:
                time.sleep(self.door_time.value)
                self.door_isClosed.value = True
            self.logger.debug(f"Door closed.")
        else:
            self.logger.debug(f"Opening door...")
            if self.door_isClosed.value:
                time.sleep(self.door_time.value)
                self.door_isClosed.value = False
            self.logger.debug(f"Door opened.")
        self.door_isMoving.value = False
        return True
    =}

    # ToolTurret
    state tt_isChanging     = {= self.data_model.get_node("MillingMachine/ToolTurret/Variables/IsChanging") =}
    state tt_currentTool    = {= self.data_model.get_node("MillingMachine/ToolTurret/Variables/CurrentTool") =}
    state tt_targetTool    = {= self.data_model.get_node("MillingMachine/ToolTurret/Variables/TargetTool") =}
    state tt_totalStations  = {= self.data_model.get_node("MillingMachine/ToolTurret/Variables/TotalStations") =}
    state tt_time           = {= self.data_model.get_node("MillingMachine/ToolTurret/Variables/Time") =}
    state tt_m_change       = {= self.data_model.get_node("MillingMachine/ToolTurret/Methods/Change") =}
    method change_tool(targetTool) {=
        if self.tt_isChanging.value:
            return False

        def directionStep(a, b, N):
            clkWise = (b - a) % N
            counter_clkWise = (a - b) % N
            if clkWise <= counter_clkWise:
                return 1
            return -1

        self.tt_isChanging.value = True
        self.logger.debug(f"Changing tool...")
        self.tt_targetTool.value = targetTool
        step = directionStep(self.tt_targetTool.value, self.tt_currentTool.value)
        while self.tt_currentTool.value != self.tt_targetTool.value:
            time.sleep(self.tt_time.value)
            self.tt_currentTool.value += step
        self.logger.debug(f"Tool changed.")
        self.tt_isChanging.value = False
        return True
    =}

    # DCMotor
    state dcm_busy          = {= self.data_model.get_node("MillingMachine/DCMotor/Variables/Busy") =}
    state dcm_currentRPM    = {= self.data_model.get_node("MillingMachine/DCMotor/Variables/CurrentRPM") =}
    state dcm_targetRPM     = {= self.data_model.get_node("MillingMachine/DCMotor/Variables/TargetRPM") =}
    state dcm_m_changeSpeed = {= self.data_model.get_node("MillingMachine/DCMotor/Methods/ChangeSpeed") =}
    method changeSpeed_dcm(targetSpeed) {=
        self.logger.debug(f"Changing speed...")
        self.dcm_targetRPM.value = targetSpeed
        step = (self.dcm_currentRPM.value - self.dcm_targetRPM.value) < 0 ? -1 : 1
        while self.dcm_currentRPM.value != self.dcm_targetRPM.value:
            if self.dcm_currentRPM.value > 0:
                if not self.dcm_busy.value:
                    self.dcm_busy.value = True
            else:
                self.dcm_busy.value = False
            self.dcm_currentRPM.value += step
        self.logger.debug(f"Speed changed.")
        return True
    =}

    # Axes
    state axes_busy         = {= self.data_model.get_node("MillingMachine/Axes/Variables/Busy") =}
    state axes_XcurrentPos  = {= self.data_model.get_node("MillingMachine/Axes/Variables/X/CurrentPosition") =}
    state axes_XtargetPos   = {= self.data_model.get_node("MillingMachine/Axes/Variables/X/TargetPosition") =}
    state axes_YcurrentPos  = {= self.data_model.get_node("MillingMachine/Axes/Variables/Y/CurrentPosition") =}
    state axes_YtargetPos   = {= self.data_model.get_node("MillingMachine/Axes/Variables/Y/TargetPosition") =}
    state axes_ZcurrentPos  = {= self.data_model.get_node("MillingMachine/Axes/Variables/Z/CurrentPosition") =}
    state axes_ZtargetPos   = {= self.data_model.get_node("MillingMachine/Axes/Variables/Z/TargetPosition") =}
    state axes_m_moveTo     = {= self.data_model.get_node("MillingMachine/Axes/Methods/MoveTo") =}
    method moveTo_axes(x, y, z) {=
        self.logger.debug(f"Moving to ({x};{y};{z}) ...")
        self.axes_busy.value = True
        self.axes_XtargetPos.value = x
        self.axes_YtargetPos.value = y
        self.axes_ZtargetPos.value = z
        # X moving
        step = (self.axes_XcurrentPos.value - self.axes_XtargetPos.value) < 0 ? -1 : 1
        while self.axes_XcurrentPos.value != self.axes_XtargetPos.value:
            self.axes_XcurrentPos.value += step
        # Z moving
        step = (self.axes_ZcurrentPos.value - self.axes_ZtargetPos.value) < 0 ? -1 : 1
        while self.axes_ZcurrentPos.value != self.axes_ZtargetPos.value:
            self.axes_ZcurrentPos.value += step
        # Y moving
        step = (self.axes_YcurrentPos.value - self.axes_YtargetPos.value) < 0 ? -1 : 1
        while self.axes_YcurrentPos.value != self.axes_YtargetPos.value:
            self.axes_YcurrentPos.value += step
        self.logger.debug(f"Position reached.")
        self.axes_busy.value = False
        return True
    =}

    reaction(startup) {=
        self.door_m_openClose.callback = self.openClose_door
        self.tt_m_change.callback = self.change_tool
        self.dcm_m_start.callback = self.changeSpeed_dcm
        self.axes_m_moveTo.callback = self.moveTo_axes
    =}
}

main reactor {
    m = new EMCO_Mill_105(name="milling machine")
    bus = new FrostBus(name="frost_bus")

    m.channel_out -> bus.channel_in after 0
    bus.channel_out -> m.channel_in after 0
}