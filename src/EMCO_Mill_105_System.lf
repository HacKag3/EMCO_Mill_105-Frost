target Python{};

import FrostMachine from "../frost/src/lib/FrostMachine.lf"
import FrostBus from "../frost/src/lib/FrostBus.lf"

preamble{=
    import time
=}

reactor Door extends FrostMachine {
    state isClosed     = {= self.data_model.get_node("/Door/Variables/IsClosed") =}
    state isMoving     = {= self.data_model.get_node("/Door/Variables/IsMoving") =}
    state movingTime   = {= self.data_model.get_node("/Door/Variables/Time") =}
    state m_openClose  = {= self.data_model.get_node("/Door/Methods/OpenClose") =}

    method openClose_door(wannaClose) {=
        if self.isMoving.value:
            return False
            
        self.isMoving.value = True
        if wannaClose:
            self.logger.debug(f"Closing door...")
            if not self.isClosed.value:
                time.sleep(self.movingTime.value)
                self.isClosed.value = True
            self.logger.debug(f"Door closed.")
        else:
            self.logger.debug(f"Opening door...")
            if self.isClosed.value:
                time.sleep(self.movingTime.value)
                self.isClosed.value = False
            self.logger.debug(f"Door opened.")
        self.isMoving.value = False
        return True
    =}

    reaction(startup) {=
        self.m_openClose.callback = self.openClose_door
    =}
}

reactor ToolTurret extends FrostMachine {
    state isChanging     = {= self.data_model.get_node("/ToolTurret/Variables/IsChanging") =}
    state currentTool    = {= self.data_model.get_node("/ToolTurret/Variables/CurrentTool") =}
    state targetTool     = {= self.data_model.get_node("/ToolTurret/Variables/TargetTool") =}
    state totalStations  = {= self.data_model.get_node("/ToolTurret/Variables/TotalStations") =}
    state changeTime     = {= self.data_model.get_node("/ToolTurret/Variables/Time") =}
    state m_change       = {= self.data_model.get_node("/ToolTurret/Methods/Change") =}

    method change_tool(targetTool) {=
        if self.isChanging.value:
            return False

        def directionStep(a, b, N):
            clkWise = (b - a) % N
            counter_clkWise = (a - b) % N
            if clkWise <= counter_clkWise:
                return 1
            return -1

        self.isChanging.value = True
        self.logger.debug(f"Changing tool...")
        self.targetTool.value = targetTool
        step = directionStep(self.targetTool.value, self.currentTool.value)
        while self.currentTool.value != self.targetTool.value:
            time.sleep(self.changeTime.value)
            self.currentTool.value += step
        self.logger.debug(f"Tool changed.")
        self.isChanging.value = False
        return True
    =}

    reaction(startup) {=
        self.m_change.callback = self.change_tool
    =}
}

reactor Spindle extends FrostMachine {
    state busy          = {= self.data_model.get_node("/DCMotor/Variables/Busy") =}
    state currentRPM    = {= self.data_model.get_node("/DCMotor/Variables/CurrentRPM") =}
    state targetRPM     = {= self.data_model.get_node("/DCMotor/Variables/TargetRPM") =}
    state m_changeSpeed = {= self.data_model.get_node("/DCMotor/Methods/ChangeSpeed") =}

    method changeSpeed_dcm(targetSpeed) {=
        self.logger.debug(f"Changing speed...")
        self.targetRPM.value = targetSpeed
        step = (self.currentRPM.value - self.targetRPM.value) < 0 ? -1 : 1
        while self.currentRPM.value != self.targetRPM.value:
            if self.currentRPM.value > 0:
                if not self.busy.value:
                    self.busy.value = True
            else:
                self.busy.value = False
            time.sleep(1)
            self.currentRPM.value += step
        self.logger.debug(f"Speed changed.")
        return True
    =}

    reaction(startup) {=
        self.m_start.callback = self.changeSpeed_dcm
    =}
}

reactor AxesMotor extends FrostMachine {
    state busy         = {= self.data_model.get_node("/Axes/Variables/Busy") =}
    state XcurrentPos  = {= self.data_model.get_node("/Axes/Variables/X/CurrentPosition") =}
    state XtargetPos   = {= self.data_model.get_node("/Axes/Variables/X/TargetPosition") =}
    state YcurrentPos  = {= self.data_model.get_node("/Axes/Variables/Y/CurrentPosition") =}
    state YtargetPos   = {= self.data_model.get_node("/Axes/Variables/Y/TargetPosition") =}
    state ZcurrentPos  = {= self.data_model.get_node("/Axes/Variables/Z/CurrentPosition") =}
    state ZtargetPos   = {= self.data_model.get_node("/Axes/Variables/Z/TargetPosition") =}
    state m_moveTo     = {= self.data_model.get_node("/Axes/Methods/MoveTo") =}

    method moveTo_axes(x, y, z) {=
        self.logger.debug(f"Moving to ({x};{y};{z}) ...")
        self.busy.value = True
        self.XtargetPos.value = x
        self.YtargetPos.value = y
        self.ZtargetPos.value = z
        # X moving
        step = (self.XcurrentPos.value - self.XtargetPos.value) < 0 ? -1 : 1
        while self.XcurrentPos.value != self.XtargetPos.value:
            self.XcurrentPos.value += step
        # Z moving
        step = (self.ZcurrentPos.value - self.ZtargetPos.value) < 0 ? -1 : 1
        while self.ZcurrentPos.value != self.ZtargetPos.value:
            self.ZcurrentPos.value += step
        # Y moving
        step = (self.YcurrentPos.value - self.YtargetPos.value) < 0 ? -1 : 1
        while self.YcurrentPos.value != self.YtargetPos.value:
            self.YcurrentPos.value += step
        self.logger.debug(f"Position reached.")
        self.busy.value = False
        return True
    =}

    reaction(startup) {=
        self.m_moveTo.callback = self.moveTo_axes
    =}
}

reactor EMCO_Mill_105 extends FrostMachine{
    # MillingMachine
    state busy          = {= self.data_model.get_node("MillingMachine/Busy") =}
    state m_startTask     = {= self.data_model.get_node("MillingMachine/StartTask") =}

    method startTask(tool, speed, x, y, z) {=
        return True
    =}
    
    reaction(startup) {=
        self.m_startTask.callback = startTask
    =}
}

main reactor {
    d = new Door(name="Door")
    t = new ToolTurret(name="Tool_Turret")
    a = new AxesMotor(name="Axes")
    s = new Spindle(name="DC_motor")
    m = new EMCO_Mill_105(name="Milling_Machine")
    bus = new FrostBus(name="frost_bus", width=5)

    d.channel_out, t.channel_out, a.channel_out , s.channel_out, m.channel_out -> bus.channel_in after 0
    bus.channel_out -> d.channel_in, t.channel_in, a.channel_in , s.channel_in, m.channel_in after 0
}