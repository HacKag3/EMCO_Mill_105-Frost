target Python{
    files: [
        "frost/src/python_lib/frost.py",
        "frost/src/python_lib/l_formatter.py",
        "frost/src/python_lib/time_utils.py",
    ],
}

import FrostMachine from "../frost/src/lib/FrostMachine.lf"
import FrostBus from "../frost/src/lib/FrostBus.lf"

preamble{=
    from frost import *
    from frost_planner.generator.instance_generator import load_instance_from_json
    from frost_planner.executor.static_executor import StaticExecutor
    from frost_planner.solver.genetic_solver import GeneticAlgorithmSolver
=}

reactor Scheduler(_scheduling_instance="undefined", _scheduling_interval=1) extends FrostMachine{
    state scheduling_instance = _scheduling_instance
    state scheduling_interval = _scheduling_interval # in seconds
    state _executor
    state _active_tasks = {={}=}
    logical action task_completed
    logical action start_tasks
    logical action update_schedule

    reaction(startup) {=
        self.scheduling_instance = load_instance_from_json(self.scheduling_instance)
        self._executor = StaticExecutor(GeneticAlgorithmSolver(instance=self.scheduling_instance))
    =}

    method create_method_request(t, method_path, args, kwargs){=
        return self.message_builder.build_invoke_method_message(
            target=t,
            node=method_path,
            args=args,
            kwargs=kwargs
        )
    =}

    // @label connected_to_bus
    reaction(connected_to_bus) -> update_schedule{=
        self.logger.info("Connected to bus. Starting scheduling...")
        update_schedule.schedule(0)
    =}

    // @label update_schedule
    reaction(update_schedule) -> update_schedule, start_tasks{=
        executor = self._executor
        logical_time = self._get_current_logical_time_sec()
        self.logger.debug(f"Scheduling at logical time {logical_time} sec")
        executor.update_task_status()
        schedule = executor.update_schedule(start_time=logical_time)

        # get the tasks that can be started now
        next_tasks = executor.next_ready_tasks()
        start_tasks.schedule(0, next_tasks)

        scheduling_interval = SECS(self.scheduling_interval)
        self.logger.debug(f"Scheduling next task in {scheduling_interval}...")
        update_schedule.schedule(scheduling_interval)
    =}

    // @label run_tasks
    reaction(start_tasks) {=
        self.logger.debug(f"Starting tasks: {start_tasks.value}")

        for task, machine in start_tasks.value:
            # machine = machine.name
            task_name = task.task.name
            self.logger.info(f"Starting task {task_name} on machine {machine}")
            task.start_time = self._get_current_logical_time_sec()
            self._executor.task_started(task)

            msg = self.create_method_request(self.data_model.name, f"/Scheduler/StartTask", args=[machine, f"/MillingMachine/CFG_Method/{task_name}"], kwargs={})
            self._active_tasks[msg.correlation_id] = task
            self.protocol_mng.handle_request(msg)

    =}

    reaction(response_messages) {=
        for bank_index, message in response_messages.value:

            if message.correlation_id not in self._active_tasks:
                continue

            if message.header.msg_name != MethodMsgName.COMPLETED:
                continue

            task = self._active_tasks.pop(message.correlation_id)
            task.end_time = self._get_current_logical_time_sec()
            self._executor.task_completed(task)
            self.logger.warning(f"Task {task.task.name} completed on machine {task.machine.name}")

    =}
    
    reaction(shutdown) {=
        tasks = [task for job in self.scheduling_instance.jobs for task in job.tasks]
        assert all(
            task.status == TaskStatus.COMPLETED for task in tasks
        ), "Not all tasks were completed"
    =}
}

reactor EMCO_Mill_105 extends FrostMachine{
    # MillingMachine
    state mill_busy
    
    # Door
    state door_busy
    state door_isClosed
    state door_time
    state door_m_openClose
    method openClose_door(wannaClose) {=
        if self.door_busy.value:
            return False
            
        self.door_busy.value = True
        if wannaClose:
            self.logger.info(f"Closing door...")
            if not self.door_isClosed.value:
                self.door_isClosed.value = True
            self.logger.info(f"Door closed.")
        else:
            self.logger.info(f"Opening door...")
            if self.door_isClosed.value:
                self.door_isClosed.value = False
            self.logger.info(f"Door opened.")
        self.door_busy.value = False
        return True
    =}

    # ToolTurret
    state tt_busy
    state tt_currentTool
    state tt_targetTool
    state tt_totalStations
    state tt_time
    state tt_m_change
    method change_tool(targetTool) {=
        if self.tt_busy.value:
            return False

        def directionStep(curr, targ, N):
            clkWise = (targ - curr) % N
            counter_clkWise = (curr - targ) % N
            if clkWise <= counter_clkWise:
                return 1
            return -1

        self.tt_busy.value = True
        self.logger.info(f"Changing tool...")
        self.tt_targetTool.value = targetTool
        step = directionStep(self.tt_currentTool.value, self.tt_targetTool.value, self.tt_totalStations.value)
        while self.tt_currentTool.value != self.tt_targetTool.value:
            next_tool = self.tt_currentTool.value + step
            if next_tool < 1:
                next_tool = self.tt_totalStations.value
            elif next_tool > self.tt_totalStations.value:
                next_tool = 1
            self.tt_currentTool.value = next_tool
        self.logger.info(f"Tool changed.")
        self.tt_busy.value = False
        return True
    =}

    # DCMotor
    state dcm_busy
    state dcm_currentRPM
    state dcm_targetRPM
    state dcm_m_changeSpeed
    method changeSpeed_dcm(targetSpeed) {=
        self.logger.info(f"Changing speed...")

        self.dcm_targetRPM.value = int(targetSpeed)

        current = int(self.dcm_currentRPM.value)
        target = int(self.dcm_targetRPM.value)

        if current == target:
            self.logger.info("Speed already reached.")
            return True

        step = 1 if target > current else -1

        self.dcm_busy.value = True

        while current != target:
            current += step

            if step > 0 and current > target:
                current = target
            elif step < 0 and current < target:
                current = target

            self.dcm_currentRPM.value = current

        self.dcm_busy.value = False

        self.logger.info("Speed changed.")

        return True
    =}

    # Axes
    state axes_busy
    state axes_XcurrentPos
    state axes_XtargetPos
    state axes_YcurrentPos
    state axes_YtargetPos
    state axes_ZcurrentPos
    state axes_ZtargetPos
    state axes_m_moveTo
    method moveTo_axes(x, y, z) {=
        self.logger.info(f"Moving to ({x};{y};{z}) ...")

        self.axes_busy.value = True

        self.axes_XtargetPos.value = int(x)
        self.axes_YtargetPos.value = int(y)
        self.axes_ZtargetPos.value = int(z)

        def move_axis(current_node, target_node, axis_name):
            current = int(current_node.value)
            target = int(target_node.value)

            if current == target:
                self.logger.info(f"{axis_name} already in position.")
                return

            step = 1 if target > current else -1

            while current != target:
                current += step

                if step > 0 and current > target:
                    current = target
                elif step < 0 and current < target:
                    current = target

                current_node.value = current

        # X moving
        move_axis(
            self.axes_XcurrentPos,
            self.axes_XtargetPos,
            "X"
        )
        # Z moving
        move_axis(
            self.axes_ZcurrentPos,
            self.axes_ZtargetPos,
            "Z"
        )
        # Y moving
        move_axis(
            self.axes_YcurrentPos,
            self.axes_YtargetPos,
            "Y"
        )

        self.logger.info("Position reached.")
        self.axes_busy.value = False
        return True
    =}

    timer check_busy(1sec, 1sec)
    logical action to_idle
    reaction(check_busy) -> to_idle {=
        is_moving_or_working = (
            self.door_busy.value or 
            self.tt_busy.value or 
            self.dcm_busy.value or 
            self.axes_busy.value
        )
        
        self.mill_busy.value = is_moving_or_working
        
        if not is_moving_or_working:
            to_idle.schedule(SECS(0))
    =}
    reaction(to_idle) {=
        self.logger.info(f"Millinig Machine is now idle.")
    =}

    reaction(startup) {=
        self.mill_busy                  = self.data_model.get_node("/MillingMachine/Busy")

        self.door_busy                  = self.data_model.get_node("/MillingMachine/Door/Variables/Busy")
        self.door_isClosed              = self.data_model.get_node("/MillingMachine/Door/Variables/IsClosed")
        self.door_time                  = self.data_model.get_node("/MillingMachine/Door/Variables/Time")
        self.door_m_openClose           = self.data_model.get_node("/MillingMachine/Door/Methods/OpenClose")
        self.door_m_openClose.callback  = self.openClose_door

        self.tt_busy                    = self.data_model.get_node("/MillingMachine/ToolTurret/Variables/Busy")
        self.tt_currentTool             = self.data_model.get_node("/MillingMachine/ToolTurret/Variables/CurrentTool")
        self.tt_targetTool              = self.data_model.get_node("/MillingMachine/ToolTurret/Variables/TargetTool")
        self.tt_totalStations           = self.data_model.get_node("/MillingMachine/ToolTurret/Variables/TotalStations")
        self.tt_time                    = self.data_model.get_node("/MillingMachine/ToolTurret/Variables/Time")
        self.tt_m_change                = self.data_model.get_node("/MillingMachine/ToolTurret/Methods/Change")
        self.tt_m_change.callback       = self.change_tool

        self.dcm_busy                   = self.data_model.get_node("/MillingMachine/DCMotor/Variables/Busy")
        self.dcm_currentRPM             = self.data_model.get_node("/MillingMachine/DCMotor/Variables/CurrentRPM")
        self.dcm_targetRPM              = self.data_model.get_node("/MillingMachine/DCMotor/Variables/TargetRPM")
        self.dcm_m_changeSpeed          = self.data_model.get_node("/MillingMachine/DCMotor/Methods/ChangeSpeed")
        self.dcm_m_changeSpeed.callback       = self.changeSpeed_dcm
        
        self.axes_busy                  = self.data_model.get_node("/MillingMachine/Axes/Variables/Busy")
        self.axes_XcurrentPos           = self.data_model.get_node("/MillingMachine/Axes/Variables/X/CurrentPosition")
        self.axes_XtargetPos            = self.data_model.get_node("/MillingMachine/Axes/Variables/X/TargetPosition")
        self.axes_YcurrentPos           = self.data_model.get_node("/MillingMachine/Axes/Variables/Y/CurrentPosition")
        self.axes_YtargetPos            = self.data_model.get_node("/MillingMachine/Axes/Variables/Y/TargetPosition")
        self.axes_ZcurrentPos           = self.data_model.get_node("/MillingMachine/Axes/Variables/Z/CurrentPosition")
        self.axes_ZtargetPos            = self.data_model.get_node("/MillingMachine/Axes/Variables/Z/TargetPosition")
        self.axes_m_moveTo              = self.data_model.get_node("/MillingMachine/Axes/Methods/MoveTo")
        self.axes_m_moveTo.callback     = self.moveTo_axes
    =}
}

main reactor {
    bus = new FrostBus(name="frost_bus", width=2)
    s = new Scheduler(name="scheduler")
    m = new EMCO_Mill_105(name="milling_machine")

    s.channel_out, m.channel_out -> bus.channel_in after 0
    bus.channel_out -> s.channel_in, m.channel_in after 0
}